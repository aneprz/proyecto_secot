# Supabase (cliente JS)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Postgres (Dashboard -> Settings -> Database -> Connection info)
# Opción A (recomendada): separar host/puerto/etc.
# IMPORTANTE: en SUPABASE_DB_HOST va SOLO el host (ej: db.<project-ref>.supabase.co),
# no el connection string completo.
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SCHEMA=public
SUPABASE_DB_SSLMODE=require
# Si usas el Connection Pooler, normalmente el usuario es `postgres.<project-ref>`
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Opción B: URL JDBC completa (si la pones, se usa esta)
# SUPABASE_DB_JDBC_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require&currentSchema=public

# Nota: si pegas un "postgresql://user:pass@host:port/db?sslmode=..." en SUPABASE_DB_HOST,
# el script intentará parsearlo, pero es mejor usar la Opción A o SUPABASE_DB_JDBC_URL.
