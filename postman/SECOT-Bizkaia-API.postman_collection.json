          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));",
              "",
              "pm.sendRequest({",
              "  url: `${pm.variables.get('baseUrl')}/seniors/${pm.variables.get('senior_id')}`,",
              "  method: 'GET',",
              "  header: {",
              "    Authorization: `Bearer ${pm.collectionVariables.get('access_token')}`",
              "  }",
              "}, (err, res) => {",
              "  pm.test('después de hard delete devuelve 404', () => {",
                "    pm.expect(err).to.equal(null);",
